[alias]
	ci = "commit"
	cleanup = "!git branch --merged | grep -v main | grep -v master | xargs -I{} git branch -d {}"
	co = "checkout"
	force-push = "push -f --force-with-lease --force-if-includes"
	rr = "restore"
	rs = "restore --staged"
	st = "status"

[color]
	ui = true

[core]
	autoCRLF = false
	fileMode = false
	fscache = true
	preloadindex = true
	quotepath = false

[gpg]
	format = "ssh"

[init]
	defaultBranch = "main"

